#!/bin/bash
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

curl -fsSL \
  "https://github.com/docker/compose/releases/download/v${docker_compose_version}/docker-compose-linux-x86_64" \
  -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose
ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose

mkdir -p \
  /opt/letterpick-observability/prometheus \
  /opt/letterpick-observability/tempo \
  /opt/letterpick-observability/grafana/provisioning/datasources \
  /opt/letterpick-observability/data/prometheus \
  /opt/letterpick-observability/data/tempo \
  /opt/letterpick-observability/data/grafana

chmod -R 0777 /opt/letterpick-observability/data

cat >/opt/letterpick-observability/prometheus/prometheus.yml <<'PROMETHEUS_CONFIG'
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090
PROMETHEUS_CONFIG

cat >/opt/letterpick-observability/tempo/tempo.yml <<'TEMPO_CONFIG'
server:
  http_listen_port: 3200

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317
        http:
          endpoint: 0.0.0.0:4318

ingester:
  trace_idle_period: 10s
  max_block_duration: 5m

compactor:
  compaction:
    block_retention: 24h

storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/traces
TEMPO_CONFIG

cat >/opt/letterpick-observability/grafana/provisioning/datasources/datasources.yml <<'GRAFANA_DATASOURCES'
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true

  - name: Tempo
    type: tempo
    access: proxy
    url: http://tempo:3200
GRAFANA_DATASOURCES

cat >/opt/letterpick-observability/docker-compose.yml <<'COMPOSE'
services:
  prometheus:
    image: ${prometheus_image}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=3d
      - --web.enable-remote-write-receiver
    ports:
      - "${prometheus_port}:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./data/prometheus:/prometheus

  tempo:
    image: ${tempo_image}
    restart: unless-stopped
    command:
      - -config.file=/etc/tempo/tempo.yml
    ports:
      - "${tempo_otlp_grpc_port}:4317"
      - "${tempo_otlp_http_port}:4318"
    volumes:
      - ./tempo/tempo.yml:/etc/tempo/tempo.yml:ro
      - ./data/tempo:/var/tempo

  grafana:
    image: ${grafana_image}
    restart: unless-stopped
    depends_on:
      - prometheus
      - tempo
    ports:
      - "127.0.0.1:${grafana_port}:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: letterpick-dev
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./data/grafana:/var/lib/grafana
COMPOSE

cat >/etc/systemd/system/letterpick-observability.service <<'SERVICE'
[Unit]
Description=LetterPick dev observability stack
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/letterpick-observability
ExecStart=/usr/local/bin/docker-compose up -d
ExecStop=/usr/local/bin/docker-compose down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now letterpick-observability.service

cat >/opt/letterpick-observability/README.txt <<'README'
LetterPick dev observability stack

Grafana:
  http://localhost:3000

Use SSM port forwarding from your local machine:
  aws ssm start-session \
    --target <observability_instance_id> \
    --document-name AWS-StartPortForwardingSession \
    --parameters '{"portNumber":["3000"],"localPortNumber":["3000"]}'

Default Grafana login:
  admin / letterpick-dev
README
