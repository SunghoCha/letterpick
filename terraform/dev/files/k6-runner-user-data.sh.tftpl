#!/bin/bash
set -euxo pipefail

dnf install -y https://dl.k6.io/rpm/repo.rpm
dnf install -y git jq k6 docker python3 python3-boto3 redis6
systemctl enable --now docker

mkdir -p /opt/letterpick-k6/results

cat >/opt/letterpick-k6/public-feed-search.js <<'K6_SCRIPT'
${public_feed_search_script}
K6_SCRIPT

cat >/opt/letterpick-k6/public-issue-view-count.js <<'K6_SCRIPT'
${public_issue_view_count_script}
K6_SCRIPT

cat >/opt/letterpick-k6/send-trending-score-events.py <<'SCORE_EVENT_SCRIPT'
${trending_score_events_script}
SCORE_EVENT_SCRIPT
chmod +x /opt/letterpick-k6/send-trending-score-events.py

cat >/opt/letterpick-k6/send-trending-score-events.sh <<'SCORE_EVENT_RUNNER'
#!/bin/bash
set -euo pipefail

export TRENDING_SCORE_EVENTS_QUEUE_URL="${trending_score_events_queue_url}"
export AWS_REGION="${aws_region}"
export AWS_DEFAULT_REGION="${aws_region}"
exec python3 /opt/letterpick-k6/send-trending-score-events.py "$@"
SCORE_EVENT_RUNNER
chmod +x /opt/letterpick-k6/send-trending-score-events.sh

cat >/opt/letterpick-k6/seed-public-feed.sh <<'SEED_SCRIPT'
${seed_public_feed_script}
SEED_SCRIPT
chmod +x /opt/letterpick-k6/seed-public-feed.sh

cat >/opt/letterpick-k6/seed-public-ranking-view-source.sh <<'RANKING_VIEW_SEED_SCRIPT'
${seed_public_ranking_view_source_script}
RANKING_VIEW_SEED_SCRIPT
chmod +x /opt/letterpick-k6/seed-public-ranking-view-source.sh

cat >/opt/letterpick-k6/README.txt <<'README'
LetterPick k6 runner

Scripts:
  /opt/letterpick-k6/seed-public-feed.sh
  /opt/letterpick-k6/seed-public-ranking-view-source.sh
  /opt/letterpick-k6/public-feed-search.js
  /opt/letterpick-k6/public-issue-view-count.js
  /opt/letterpick-k6/send-trending-score-events.sh

Seed public feed source data and candidates after dev services are running:
  PUBLIC_FEED_SEED_ISSUE_COUNT=100000 \
  /opt/letterpick-k6/seed-public-feed.sh

Seed 100 DB issues and Redis AVAILABLE state for ranking view-count experiments:
  PUBLIC_RANKING_VIEW_SEED_KEY=ranking-view-$(date -u +%Y%m%d%H%M%S) \
  PUBLIC_RANKING_VIEW_SEED_ISSUE_COUNT=100 \
  /opt/letterpick-k6/seed-public-ranking-view-source.sh

Public feed search example:
  BASE_URL=https://dev-api.letterpicknews.com \
  KEYWORD=전환 \
  RATE=5 \
  DURATION=60s \
  SEARCH_STRATEGY=like \
  k6 run \
    --summary-export /opt/letterpick-k6/results/like-10k.json \
    /opt/letterpick-k6/public-feed-search.js \
    2>&1 | tee /opt/letterpick-k6/results/like-10k.txt

Run the same scenario again after switching the backend search strategy to fulltext:
  SEARCH_STRATEGY=fulltext ...

Public issue view count example:
  BASE_URL=https://dev-api.letterpicknews.com \
  ISSUE_ID=1 \
  RATE=10 \
  DURATION=60s \
  k6 run \
    --summary-export /opt/letterpick-k6/results/public-issue-view-count-r10-60s.json \
    /opt/letterpick-k6/public-issue-view-count.js \
    2>&1 | tee /opt/letterpick-k6/results/public-issue-view-count-r10-60s.txt

Prepare ranking score snapshots for 100 public issues:
  BASE_URL=https://dev-api.letterpicknews.com \
  START_ISSUE_ID=1 \
  ISSUE_COUNT=100 \
  ITERATIONS=5000 \
  VUS=50 \
  k6 run \
    --summary-export /opt/letterpick-k6/results/public-issue-view-count-seed-100x50.json \
    /opt/letterpick-k6/public-issue-view-count.js \
    2>&1 | tee /opt/letterpick-k6/results/public-issue-view-count-seed-100x50.txt

Trending score event injection example:
  RATE=10 \
  DURATION=30s \
  CONCURRENCY=16 \
  ISSUE_COUNT=1 \
  START_ISSUE_ID=1 \
  /opt/letterpick-k6/send-trending-score-events.sh

Distribute the same event stream across multiple issues:
  RATE=100 \
  DURATION=60s \
  CONCURRENCY=16 \
  ISSUE_COUNT=1000 \
  START_ISSUE_ID=1 \
  /opt/letterpick-k6/send-trending-score-events.sh
README

k6 version >/opt/letterpick-k6/k6-version.txt
