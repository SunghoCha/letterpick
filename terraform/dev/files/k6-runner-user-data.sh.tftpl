#!/bin/bash
set -euxo pipefail

dnf install -y https://dl.k6.io/rpm/repo.rpm
dnf install -y git jq k6

mkdir -p /opt/letterpick-k6/results

cat >/opt/letterpick-k6/public-feed-search.js <<'K6_SCRIPT'
${k6_script}
K6_SCRIPT

cat >/opt/letterpick-k6/README.txt <<'README'
LetterPick k6 runner

Default script:
  /opt/letterpick-k6/public-feed-search.js

Example:
  BASE_URL=https://dev-api.letterpicknews.com \
  KEYWORD=전환 \
  RATE=5 \
  DURATION=60s \
  SEARCH_STRATEGY=like \
  k6 run \
    --summary-export /opt/letterpick-k6/results/like-10k.json \
    /opt/letterpick-k6/public-feed-search.js \
    2>&1 | tee /opt/letterpick-k6/results/like-10k.txt

Run the same scenario again after switching the backend search strategy to fulltext:
  SEARCH_STRATEGY=fulltext ...
README

k6 version >/opt/letterpick-k6/k6-version.txt
